<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_server"
            android:textStyle="bold"
            android:textColor="@color/white" />

        <EditText
            android:id="@+id/editServer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textUri"
            android:hint="@string/settings_server_hint"
            android:textColor="@color/white"
            android:textColorHint="#888888" />

        <Switch
            android:id="@+id/swAuto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_auto_update"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btnCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_check_update" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333333"
            android:layout_marginVertical="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_display"
            android:textStyle="bold"
            android:textColor="@color/white" />

        <Switch
            android:id="@+id/swPoi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/opt_poi"
            android:textColor="@color/white" />

        <Switch
            android:id="@+id/swLabels"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/opt_labels"
            android:textColor="@color/white" />

        <Switch
            android:id="@+id/swContours"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/opt_contours"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btnApplyDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_apply_display" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333333"
            android:layout_marginVertical="12dp" />

        <TextView
            android:id="@+id/txtAbout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#AAAAAA" />
    </LinearLayout>
</ScrollView>
